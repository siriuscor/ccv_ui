{
  "name": "manmori",
  "version": "1.0.0",
  "description": "grab your loved comic",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node server.js",
    "package": "npx electron-packager . Manmori --platform=darwin --arch=arm64 --overwrite --icon=public/icon.icns --asar --prune=true",
    "pack-win": "npx electron-packager . Manmori --platform=win32 --arch=x64 --overwrite --icon=public/icon.ico --prune=true --out=dist"
  },
  "keywords": [
    "comic",
    "manga"
  ],
  "author": "sirius",
  "license": "ISC",
  "dependencies": {
    "@cliqz/adblocker-puppeteer": "^1.33.0",
    "@lesjoursfr/html-to-epub": "^4.4.0",
    "fs-extra": "^11.2.0",
    "jimp": "^1.3.0",
    "jszip": "^3.2.2",
    "mime": "^2.6.0",
    "puppeteer-core": "^24.7.2",
    "puppeteer-in-electron": "^3.0.5",
    "rimraf": "^3.0.0"
  },
  "devDependencies": {
    "electron": "^31.2.1",
    "electron-builder": "^26.0.12",
    "electron-packager": "^17.1.2"
  }
}
